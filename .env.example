DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=carlixplastPrueba
DB_USER=
# Generar con: node encriptar-password.js "elPasswordReal"
DB_PASSWORD_ENC=
WEB_PORT=3000
# Cualquier texto largo/aleatorio, solo para firmar la cookie de sesion
SESSION_SECRET=
# Websocket de Node-RED del que se lee el peso de la bascula (websocket-out node en /ws/peso)
NODERED_WS_URL=ws://localhost:1880/ws/peso
# Base HTTP de Node-RED para publicar comandos (imprimir_etiqueta / cierre_bulto) en /api/comando
NODERED_HTTP_URL=http://localhost:1880
